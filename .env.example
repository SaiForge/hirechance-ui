# ==========================================
# Root Environment Variables Example Template
# Copy this file to .env and adjust values for your environment.
# ==========================================

# ------------------------------------------
# Cloud / Supabase Credentials (Optional)
# If provided via environment variables or GitHub Secrets, app will connect to Supabase/Cloud.
# If left empty, app automatically falls back to local PostgreSQL machine setup.
# ------------------------------------------
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------
# Local Machine / Docker Database Settings (Default Fallback)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=placement_db
POSTGRES_PORT=5433
POSTGRES_HOST=db

# ------------------------------------------
# Backend Settings & Security
# ------------------------------------------
BACKEND_PORT=8001
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# Frontend & Azure Service Settings
# ------------------------------------------
VITE_API_URL=http://localhost:8001
FRONTEND_PORT=5173
