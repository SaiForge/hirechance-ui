# ==========================================
# Backend Service Environment Variables Example Template
# Copy this file to backend/.env and adjust values.
# ==========================================

# ------------------------------------------
# Cloud / Supabase PostgreSQL Connection (Optional)
# If provided via Azure App Service or GitHub Secrets, backend connects to Supabase.
# If empty, backend defaults to local Postgres below.
# ------------------------------------------
SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ------------------------------------------
# Local Machine / Docker Database Fallback Credentials
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=placement_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL can also be explicitly overridden if desired:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_db

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------
# CORS & Server Settings
# ------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
HOST=0.0.0.0
PORT=8000
